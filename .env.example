# 敏感配置示例（复制为 .env 或直接在 shell / 容器中注入）
# 注意：ASP.NET Core 不会自动读取 .env 文件，这里仅作为环境变量清单。
# .env 已被 .gitignore 忽略，请勿提交真实值。

# 必填（生产环境）：独立随机密钥，不要使用演示默认值
AIC_ENCRYPTION_KEY=
AIC_TOKEN_SIGNING_KEY=

# 网关对外地址
AIC_PUBLIC_BASE_URL=http://localhost:5080

# SQLite 文件路径（数据库文件已被 .gitignore 忽略）
AIC_DB_CONNECTION=aicontrol.db

# 本地开发开关；生产环境必须为 false
AIC_DEV_LOGIN_ENABLED=false
AIC_SEED_DEMO=true

# models.dev 目录
MODELS_DEV_API_URL=https://models.dev/api.json

# 飞书 App ID / App Secret、渠道上游密钥请在控制台「系统设置 / 供应商与模型」中录入，
# 由 AIC_ENCRYPTION_KEY 加密后存库，不写入本文件。