{
  "name": "@aicontrol/cli",
  "version": "1.0.0",
  "description": "AIControl gateway CLI and coding-agent adapters (Pi, Codex, Claude Code, GitHub Copilot CLI)",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "aic": "./dist/bin-aic.js",
    "aic-codex": "./dist/bin-codex.js",
    "aic-claude": "./dist/bin-claude.js",
    "aic-copilot": "./dist/bin-copilot.js"
  },
  "pi": {
    "extensions": [
      "./dist/pi-extension.js"
    ]
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "test:project": "node scripts/project-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "~5.9.3"
  }
}
