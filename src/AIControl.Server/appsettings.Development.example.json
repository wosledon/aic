{
  "_comment": "复制为 appsettings.Development.json 后使用；该文件已被 .gitignore 忽略。生产环境请通过 AIC_ENCRYPTION_KEY / AIC_TOKEN_SIGNING_KEY 注入，不要提交密钥。",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AIC": {
    "DevLoginEnabled": true,
    "Encryption": {
      "Key": "replace-with-a-random-32+-char-secret"
    },
    "Token": {
      "SigningKey": "replace-with-a-random-64+-char-secret"
    }
  }
}