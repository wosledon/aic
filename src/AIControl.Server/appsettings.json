{
  "ConnectionStrings": {
    "Default": "Data Source=aicontrol.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AIC": {
    "PublicBaseUrl": "http://localhost:5080",
    "MaxBodyBytes": 33554432,
    "UpstreamTimeoutSeconds": 300,
    "DevLoginEnabled": false,
    "Token": {
      "Issuer": "aicontrol",
      "Audience": "aicontrol",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30
    },
    "ModelsDev": {
      "ModelsDevApiUrl": "https://models.dev/api.json",
      "TimeoutSeconds": 30,
      "MaxBytes": 20971520
    },
    "Seeder": {
      "SeedDemoData": true,
      "BootstrapAdminUnionId": "dev-admin",
      "BootstrapAdminEmail": "admin@aic.local",
      "ModelsDevFixturePath": "../../.modelsdev.json"
    }
  }
}
